##############################################################################
# My Books — environment template
#
# Copy to .env and adjust. The docker-compose stack already injects working
# values for local development, so a fresh clone needs no edits to start.
#
# NEVER commit a real .env. Every secret below must be regenerated per
# deployment — see SECURITY.md, "Secret management".
##############################################################################

APP_NAME="My Books"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8080

# Everything is stored and computed in UTC. Each organisation carries its own
# timezone for display, set during onboarding — never the server default.
APP_TIMEZONE=UTC
APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_PK

APP_MAINTENANCE_DRIVER=file
PHP_CLI_SERVER_WORKERS=4

# argon2id for passwords. Memory-hard, so a leaked hash table costs an attacker
# real hardware to attack rather than just time. BCRYPT_ROUNDS is kept only so
# legacy bcrypt hashes can still be verified during a migration.
HASH_DRIVER=argon2id
ARGON_MEMORY=65536
ARGON_TIME=4
ARGON_THREADS=1
BCRYPT_ROUNDS=12

##############################################################################
# Database
#
# Two connections, on purpose.
#
#   pgsql        the application. Connects as a role that owns nothing, so
#                PostgreSQL row-level security is always enforced against it.
#   pgsql_owner  migrations and maintenance. Owns the schema, and therefore
#                bypasses RLS — which is what a migration needs and what web
#                traffic must never have.
#
# See docker/postgres/init/01-app-role.sql and docs/adr/0002-multi-tenancy.md
##############################################################################

DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=my_books
DB_USERNAME=my_books_app
DB_PASSWORD=my_books_app

DB_OWNER_USERNAME=my_books
DB_OWNER_PASSWORD=my_books

##############################################################################
# Redis — cache, sessions, queues, rate limiting.
# Never a source of truth. Losing Redis logs everyone out and pauses the
# queue; it must never lose a posted journal entry.
##############################################################################

REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

CACHE_STORE=redis
CACHE_PREFIX=my_books_cache

SESSION_DRIVER=redis
SESSION_LIFETIME=480
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=false
SESSION_SAME_SITE=lax

QUEUE_CONNECTION=redis
HORIZON_PREFIX=my_books_horizon

BROADCAST_CONNECTION=log

##############################################################################
# Object storage — receipts, attachments, generated PDFs.
# Files live in object storage; the database stores only metadata.
##############################################################################

FILESYSTEM_DISK=s3

AWS_ACCESS_KEY_ID=my_books
AWS_SECRET_ACCESS_KEY=my_books_secret
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=my-books
AWS_ENDPOINT=http://minio:9000
AWS_URL=http://localhost:9000/my-books
AWS_USE_PATH_STYLE_ENDPOINT=true

##############################################################################
# Mail — Mailpit captures everything locally at http://localhost:8025
# so testing invoice delivery can never reach a real customer.
##############################################################################

MAIL_MAILER=smtp
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="no-reply@my-books.local"
MAIL_FROM_NAME="${APP_NAME}"

##############################################################################
# Logging
#
# Structured JSON so logs are queryable. Redaction of secrets and financial
# detail is configured in config/logging.php, not here — a log line must
# never carry a password, token, or a customer's balance.
##############################################################################

LOG_CHANNEL=stack
LOG_STACK=daily
LOG_LEVEL=debug
LOG_DEPRECATIONS_CHANNEL=null

##############################################################################
# Frontend
##############################################################################

VITE_APP_NAME="${APP_NAME}"
VITE_DEV_SERVER_URL=http://localhost:5173

##############################################################################
# Accounting defaults
#
# These seed a NEW organisation during onboarding. They are not global truth:
# once an organisation exists, its own settings govern, because two
# organisations in one deployment may file in different jurisdictions.
##############################################################################

# Jurisdiction rule pack applied to new organisations. Ships: PK.
MY_BOOKS_DEFAULT_JURISDICTION=PK
MY_BOOKS_DEFAULT_CURRENCY=PKR
MY_BOOKS_DEFAULT_TIMEZONE=Asia/Karachi

# Half-up is the default rounding mode for money. Changing this changes
# reported figures — it is an organisation-level accounting policy, and this
# value only seeds the initial setting.
MY_BOOKS_DEFAULT_ROUNDING=HALF_UP

##############################################################################
# Security
#
# Generate real values before any deployment reachable from a network:
#   php artisan key:generate
##############################################################################

# Comma-separated hosts allowed to serve the application. Empty = any.
MY_BOOKS_TRUSTED_HOSTS=

# Requests per minute per authenticated user against /api/v1.
MY_BOOKS_API_RATE_LIMIT=120

# Failed sign-in attempts before an account is temporarily locked.
MY_BOOKS_LOGIN_MAX_ATTEMPTS=5
MY_BOOKS_LOGIN_DECAY_MINUTES=15
