{
    "$schema": "https://getcomposer.org/schema.json",
    "name": "my-books/my-books",
    "type": "project",
    "description": "My Books — a self-hosted, double-entry accounting and business management platform.",
    "keywords": ["accounting", "bookkeeping", "double-entry", "invoicing", "self-hosted", "laravel"],
    "license": "proprietary",
    "require": {
        "php": "^8.4",
        "brick/money": "^0.14.2",
        "inertiajs/inertia-laravel": "^3.3",
        "laravel/framework": "^13.17",
        "laravel/fortify": "^1.39",
        "laravel/horizon": "^5.48",
        "laravel/sanctum": "^4.3",
        "laravel/tinker": "^3.0",
        "league/flysystem-aws-s3-v3": "^3.35",
        "spatie/laravel-data": "^4.23",
        "spatie/laravel-typescript-transformer": "^3.3",
        "tightenco/ziggy": "^2.6"
    },
    "require-dev": {
        "barryvdh/laravel-ide-helper": "^3.7",
        "fakerphp/faker": "^1.23",
        "larastan/larastan": "^3.11",
        "laravel/pail": "^1.2.5",
        "laravel/pint": "^1.27",
        "mockery/mockery": "^1.6",
        "nunomaduro/collision": "^8.6",
        "pestphp/pest": "^5.1",
        "pestphp/pest-plugin-browser": "^5.0",
        "pestphp/pest-plugin-laravel": "^5.0",
        "pestphp/pest-plugin-type-coverage": "^5.0"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Database\\Factories\\": "database/factories/",
            "Database\\Seeders\\": "database/seeders/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi"
        ],
        "post-update-cmd": [
            "@php artisan vendor:publish --tag=laravel-assets --ansi --force"
        ],
        "pre-package-uninstall": [
            "Illuminate\\Foundation\\ComposerScripts::prePackageUninstall"
        ],

        "lint": "pint --test",
        "lint:fix": "pint",
        "analyse": "phpstan analyse --memory-limit=1G",
        "types": "pest --type-coverage --min=95",

        "test": "pest --parallel",
        "test:unit": "pest --parallel --testsuite=Unit",
        "test:feature": "pest --parallel --testsuite=Feature",
        "test:accounting": [
            "Composer\\Config::disableProcessTimeout",
            "pest --testsuite=Accounting"
        ],
        "test:browser": [
            "Composer\\Config::disableProcessTimeout",
            "pest --testsuite=Browser"
        ],
        "test:coverage": "pest --parallel --coverage --min=80",

        "check": [
            "@lint",
            "@analyse",
            "@test"
        ],

        "ide": [
            "@php artisan ide-helper:generate",
            "@php artisan ide-helper:meta",
            "@php artisan ide-helper:models --nowrite"
        ]
    },
    "scripts-descriptions": {
        "lint": "Check code style with Pint (no changes written).",
        "lint:fix": "Apply Pint code style fixes.",
        "analyse": "Run PHPStan/Larastan static analysis.",
        "types": "Report PHP type coverage; fails under 95%.",
        "test": "Run the full Pest suite in parallel.",
        "test:accounting": "Run only the accounting invariant suite (serial — it asserts ledger-wide state).",
        "test:browser": "Run Pest browser tests against the running application.",
        "check": "Everything CI runs: style, static analysis, tests.",
        "ide": "Regenerate IDE helper files for the Laravel developer's editor."
    },
    "extra": {
        "laravel": {
            "dont-discover": []
        }
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "php-http/discovery": true
        }
    },
    "//": "No config.platform block on purpose. Dependencies are resolved INSIDE the application image (docker/app/Dockerfile), so the resolution environment is the runtime environment — exact PHP patch version and every installed extension. Resolving on a host with a different PHP produces a lock file that is valid nowhere. See CLAUDE.md, 'Working on this codebase'.",
    "minimum-stability": "stable",
    "prefer-stable": true
}
