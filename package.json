{
    "name": "my-books",
    "private": true,
    "type": "module",
    "engines": {
        "node": ">=22"
    },
    "scripts": {
        "dev": "vite",
        "build": "tsc --noEmit && vite build",
        "build:ssr": "vite build && vite build --ssr",
        "preview": "vite preview",
        "typecheck": "tsc --noEmit",
        "lint": "eslint resources/js --max-warnings=0",
        "lint:fix": "eslint resources/js --fix",
        "format": "prettier --check resources/js resources/css",
        "format:fix": "prettier --write resources/js resources/css",
        "check": "npm run typecheck && npm run lint && npm run format",
        "test": "vitest run",
        "test:watch": "vitest"
    },
    "dependencies": {
        "@fontsource-variable/ibm-plex-sans": "^5.3.0",
        "@fontsource/ibm-plex-mono": "^5.3.0",
        "@inertiajs/react": "^3.7.0",
        "@tanstack/react-table": "^9.2.4",
        "clsx": "^2.1.1",
        "date-fns": "^4.4.0",
        "lucide-react": "^1.41.0",
        "react": "^19.2.8",
        "react-dom": "^19.2.8",
        "tailwind-merge": "^3.6.0",
        "ziggy-js": "^2.6.4"
    },
    "devDependencies": {
        "@eslint/js": "^9.39.5",
        "@tailwindcss/vite": "^4.3.3",
        "@testing-library/jest-dom": "^7.0.1",
        "@testing-library/react": "^16.3.3",
        "@testing-library/user-event": "^14.6.7",
        "@types/node": "^26.4.1",
        "@types/react": "^19.2.2",
        "@types/react-dom": "^19.2.2",
        "@vitejs/plugin-react": "^6.1.1",
        "axe-core": "^4.13.0",
        "eslint": "^9.39.5",
        "eslint-plugin-jsx-a11y": "^6.10.2",
        "eslint-plugin-react-hooks": "^7.1.1",
        "eslint-plugin-react-refresh": "^0.5.6",
        "globals": "^17.12.0",
        "jsdom": "^30.0.1",
        "laravel-vite-plugin": "^3.2.0",
        "playwright": "^1.63.0",
        "prettier": "^3.9.6",
        "prettier-plugin-tailwindcss": "^0.8.1",
        "tailwindcss": "^4.3.3",
        "typescript": "^5.9.3",
        "typescript-eslint": "^8.69.0",
        "vite": "^8.2.2",
        "vitest": "^5.0.0"
    },
    "prettier": {
        "semi": true,
        "singleQuote": true,
        "trailingComma": "all",
        "printWidth": 100,
        "tabWidth": 4,
        "plugins": [
            "prettier-plugin-tailwindcss"
        ],
        "overrides": [
            {
                "files": [
                    "*.css",
                    "*.json",
                    "*.yml",
                    "*.yaml",
                    "*.md"
                ],
                "options": {
                    "tabWidth": 2
                }
            }
        ]
    }
}
